# FNP Template Frontend - Environment Variables
# Copy to `.env.local` and adjust. `.env.local` is gitignored.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# ---------- Backend mode ----------
# When "true" (default), services in src/lib/services/* return mock data.
# Set to "false" to call the real backend (requires NEXT_PUBLIC_API_BASE_URL).
NEXT_PUBLIC_USE_MOCK=true

# Real backend root URL. Used by Access Control and when NEXT_PUBLIC_USE_MOCK=false.
# Example: http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Server-side API URL (Docker: http://api:8000/api/v1). Optional locally.
# API_BASE_URL=
